{
  "name": "json-highlighter",
  "version": "1.5.0",
  "description": "A component to highlight values in JSON text",
  "main": "dist/index.js",
  "source": "src/index.js",
  "author": "Yehonatan Sayag",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "!**/*.test.js",
    "!**/__tests__/**"
  ],
  "scripts": {
    "build": "rm -rf dist && babel src --out-dir dist --copy-files --no-copy-ignored --ignore \"src/**/*.test.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "react-highlight-words": "^0.21.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayag11/JsonHighlighter.git"
  },
  "keywords": [
    "json-highlight"
  ],
  "bugs": {
    "url": "https://github.com/sayag11/JsonHighlighter/issues"
  },
  "homepage": "https://github.com/sayag11/JsonHighlighter#readme"
}
